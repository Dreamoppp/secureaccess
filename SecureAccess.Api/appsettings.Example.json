{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SecureAccessConnection": "Server=YOUR_SQL_SERVER_HOST;Database=SecureAccessDB;User Id=YOUR_DB_USER;Password=YOUR_SECURE_PASSWORD;TrustServerCertificate=False;Encrypt=True;"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_YOUR_STRONG_PRODUCTION_SECRET_KEY_MINIMUM_32_BYTES_LONG",
    "Issuer": "SecureAccessApi",
    "Audience": "SecureAccessClients",
    "ExpiresInMinutes": 60
  },
  "UseInMemoryDatabase": false
}
